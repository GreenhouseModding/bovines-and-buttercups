{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "test:item/truffle/blue_truffle_block"
        },
        "when": "test:blue_truffle"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "test:item/truffle/green_truffle_block"
        },
        "when": "test:green_truffle"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "test:item/truffle/red_truffle_block"
        },
        "when": "test:red_truffle"
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "bovinesandbuttercups:item/missing_mushroom_block"
    },
    "property": "bovinesandbuttercups:custom_mushroom"
  }
}